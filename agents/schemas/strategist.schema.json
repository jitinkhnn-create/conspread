{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strategist.schema.json",
  "title": "Strategist stage output",
  "type": "object",
  "required": ["stage", "post_id", "atom_id", "angle", "audience_track", "format", "cta_intent", "rationale"],
  "additionalProperties": false,
  "properties": {
    "stage": { "const": "strategist" },
    "post_id": { "type": "string", "pattern": "^post_[0-9]{8}_[0-9]{2}$" },
    "atom_id": { "type": "string", "pattern": "^bt_ch[0-9]{2}_[a-z0-9_]+$" },
    "angle": {
      "type": "string",
      "minLength": 10,
      "description": "The specific way in to the atom for this post, one or two sentences. Not the atom's core_message restated."
    },
    "audience_track": { "enum": ["child_teen", "parent_teacher"] },
    "format": { "enum": ["carousel", "single_post"] },
    "slide_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Required when format is carousel (5-8). Omit or 1 for single_post."
    },
    "cta_intent": { "enum": ["none", "save", "share", "reflect", "discover_book"] },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Why this atom, why now, why this audience/format. Feeds rationale.md."
    },
    "considered_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom_id", "why_not"],
        "additionalProperties": false,
        "properties": { "atom_id": { "type": "string" }, "why_not": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "carousel" } }, "required": ["format"] },
      "then": { "required": ["slide_count"], "properties": { "slide_count": { "minimum": 5 } } }
    }
  ]
}
