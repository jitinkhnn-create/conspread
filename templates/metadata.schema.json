{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "templates/metadata.schema.json",
  "title": "templates/{active,proposed,archived}/{id}/metadata.json",
  "description": "Contract between the art director and the deterministic renderer. One folder per canonical template. N structurally distinct references = N templates.",
  "type": "object",
  "required": ["id", "family", "status", "formats", "renderer", "layouts", "slots", "last_used_date", "use_count"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Must equal the folder name." },
    "family": { "type": "string", "description": "Groups related templates, e.g. 'editorial', 'framework_grid'. Used by rotation and analytics." },
    "status": { "enum": ["proposed", "active", "archived"] },
    "formats": { "type": "array", "minItems": 1, "items": { "enum": ["carousel", "single_post"] } },
    "renderer": { "enum": ["pillow", "playwright", "spec_only"] },
    "renderer_entry": { "type": ["string", "null"], "description": "Path to the renderer module/script, relative to the template folder. Null when spec_only." },
    "reference_files": { "type": "array", "items": { "type": "string" }, "description": "Originals under assets/benchmark/ this template was derived from." },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "roles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "roles": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Copy slide roles this layout suits (hook, body, framework_item, takeaway, cta, ...)." },
          "max_words": { "type": "integer", "minimum": 1 },
          "regions": { "type": "array", "description": "Named regions, each with box [x, y, w, h] as canvas fractions." }
        }
      }
    },
    "slots": {
      "type": "object",
      "required": ["background", "accent_color", "emphasis_style", "imagery_type"],
      "properties": {
        "background": { "type": "array", "minItems": 1, "items": { "enum": ["flat", "textured", "illustrated"] } },
        "accent_color": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Accent variant ids from design_system.json." },
        "emphasis_style": { "type": "array", "minItems": 1, "items": { "enum": ["underline", "highlight", "circle"] } },
        "imagery_type": { "type": "array", "minItems": 1, "items": { "enum": ["photo", "illustration", "abstract"] } }
      }
    },
    "last_used_date": { "type": ["string", "null"] },
    "use_count": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string" }
  }
}
