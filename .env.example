# Copy to .env (git-ignored) or export in the scheduler's environment.
# Nothing here is needed to run Phase 0/1 dry runs except the Claude Code login.

# --- Reasoning stages -------------------------------------------------------
# Routines run as `claude -p` (headless Claude Code). It uses your Claude Code
# login (run `claude` once and sign in) - no API key needed for that path.
# Only set this if you later switch runtime.backend to an API-key setup.
# ANTHROPIC_API_KEY=

# --- Publishing (needed from Phase 2 step 17) --------------------------------
# Postiz API key (Settings -> Developers -> Public API in Postiz).
POSTIZ_API_KEY=
# Cloud: https://api.postiz.com/public/v1   Self-hosted: https://<your-host>/api/public/v1
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
# The Instagram channel's integration id in Postiz (GET /integrations).
POSTIZ_INSTAGRAM_INTEGRATION_ID=

# --- Optional ----------------------------------------------------------------
# Only if a background-image provider is added later under tools/gen/.
# IMAGE_GEN_API_KEY=
