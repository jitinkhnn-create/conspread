{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "story-queue.schema.json",
  "title": "state/story-queue.json",
  "description": "Real-story submissions from inbox/real-stories/ and whether each has been used. Only tools/story_queue.py writes this file. A story is eligible only with consent: true in its frontmatter.",
  "type": "object",
  "required": ["schema_version", "stories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "status"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "status": { "enum": ["used", "reserved"] },
          "post_id": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] }
        }
      }
    }
  }
}
