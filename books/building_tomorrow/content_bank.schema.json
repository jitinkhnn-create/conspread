{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content_bank.schema.json",
  "title": "Building Tomorrow content bank",
  "description": "One row per atom. An atom is the smallest self-contained idea from the workbook that can anchor a post. The strategist may only pick atoms whose state.status is 'unused'.",
  "type": "object",
  "required": ["book", "schema_version", "atoms"],
  "additionalProperties": false,
  "properties": {
    "book": { "const": "building_tomorrow" },
    "schema_version": { "const": 1 },
    "atoms": { "type": "array", "items": { "$ref": "#/definitions/atom" } }
  },
  "definitions": {
    "atom": {
      "type": "object",
      "required": [
        "atom_id", "chapter", "chapter_title", "type", "core_message",
        "content", "audience", "suitable_formats", "source_grounding", "state"
      ],
      "additionalProperties": false,
      "properties": {
        "atom_id": {
          "type": "string",
          "pattern": "^bt_ch[0-9]{2}_[a-z0-9_]+$",
          "description": "bt_ch{NN}_{slug}. Stable forever; never reuse an id."
        },
        "chapter": { "type": "integer", "minimum": 1, "maximum": 16 },
        "chapter_title": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "concept", "framework", "question", "exercise", "quote_verbatim",
            "story", "parent_tip", "teacher_tip", "reframe", "takeaway"
          ]
        },
        "core_message": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence. The idea a reader should walk away with."
        },
        "content": {
          "type": "object",
          "description": "Type-specific payload. Free-form, but every user-visible string in here must be traceable to the chapter file (see source_grounding).",
          "minProperties": 1
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["children", "parents", "teachers"] },
          "description": "Who this atom can speak to. 'children' covers the 11-15 workbook reader."
        },
        "suitable_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["carousel", "single_post"] }
        },
        "source_grounding": {
          "enum": ["workbook_verbatim", "workbook_paraphrase", "workbook_derived"],
          "description": "workbook_verbatim: every content string is copied word for word from the chapter file. workbook_paraphrase: same meaning, reworded. workbook_derived: a synthesis across passages; must still not distort the source."
        },
        "source_ref": {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "description": "Path relative to books/building_tomorrow/, e.g. chapters/ch04.md" },
            "locator": { "type": "string", "description": "Heading or page marker inside the file, so a human can find the passage." }
          }
        },
        "sensitivity": {
          "enum": ["none", "emotional", "sensitive"],
          "default": "none",
          "description": "'sensitive' atoms (mental-health-adjacent, bullying, grief) are flagged for extra human attention in rationale.md. See brand/guidelines.md."
        },
        "state": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["unused", "queued", "published"] },
            "post_id": { "type": ["string", "null"], "description": "Set while queued or published." },
            "published_date": { "type": ["string", "null"], "format": "date" },
            "rejections": {
              "type": "array",
              "description": "History of human rejections. An atom returned to 'unused' keeps this list so the strategist can see what already failed.",
              "items": {
                "type": "object",
                "required": ["post_id", "date", "layer", "issue_tag"],
                "additionalProperties": false,
                "properties": {
                  "post_id": { "type": "string" },
                  "date": { "type": "string", "format": "date" },
                  "layer": { "enum": ["content", "copy", "design", "brand", "tone"] },
                  "issue_tag": { "type": "string" },
                  "action_note": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
